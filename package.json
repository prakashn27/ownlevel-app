  "devDependencies": {
    "turbo": "^2.3.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=24",
    "pnpm": ">=9.15.0"
  },
  "pnpm": {
    "overrides": {
      "jose": "6.2.14"
    }
  }
}
