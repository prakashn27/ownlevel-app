---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import { useTranslations, industryUrl, industriesIndex } from "../i18n/utils";
import type { Locale } from "../i18n/ui";

const { locale } = Astro.props as { locale: Locale };
const t = useTranslations(locale);
const items = (await getCollection("industries")).filter((i) => i.data.locale === locale);
---
<Base
  title={t("industries.title")}
  description={t("industries.title")}
  alternates={{ en: industriesIndex("en"), fr: industriesIndex("fr") }}
>
  <h1>{t("industries.title")}</h1>
  <div class="grid">
    {items.map((i) => (
      <a class="card" href={industryUrl(locale, i.data.slug)} style="text-decoration:none;color:inherit">
        <h3>{i.data.title}</h3><p>{i.data.description}</p>
      </a>
    ))}
  </div>
</Base>
