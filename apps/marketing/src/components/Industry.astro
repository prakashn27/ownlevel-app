---
import { getCollection, type CollectionEntry } from "astro:content";
import Base from "../layouts/Base.astro";
import { appUrl, useTranslations, industryUrl } from "../i18n/utils";
import type { Locale } from "../i18n/ui";

const { entry, locale } = Astro.props as { entry: CollectionEntry<"industries">; locale: Locale };
const t = useTranslations(locale);
const all = await getCollection("industries");
const alternates = Object.fromEntries(
  all.filter((i) => i.data.translationKey === entry.data.translationKey)
     .map((i) => [i.data.locale, industryUrl(i.data.locale, i.data.slug)]),
);
const d = entry.data;
---
<Base title={d.title} description={d.description} alternates={alternates}>
  <section class="hero">
    <h1>{d.headline}</h1>
    <p>{d.subhead}</p>
    <a class="btn" href={`${appUrl}/signup`}>{t("hero.cta")}</a>
  </section>
  <div class="grid">
    {d.features.map((f) => <div class="card"><h3>{f.title}</h3><p>{f.body}</p></div>)}
  </div>
</Base>
