DATABASE_URL=postgres://ownlevel:ownlevel@localhost:5432/ownlevel
BETTER_AUTH_SECRET=change-me-to-a-32+-char-random-string
BETTER_AUTH_URL=http://localhost:4000
WEB_ORIGINS=http://localhost:3100
# Agencies live at {slug}.PLATFORM_ROOT_DOMAIN (prod: ownlevel.app). Dev: *.localhost
PLATFORM_ROOT_DOMAIN=localhost
PLATFORM_HOSTS=localhost
# Shared with apps/web; the API trusts X-Forwarded-Host only with this secret.
PROXY_SHARED_SECRET=dev-proxy-secret-change-me
# Email: console output in dev; set a Resend key to actually send
EMAIL_FROM=noreply@ownlevel.app
RESEND_API_KEY=
# MCP / OAuth: the API is the authorization server for MCP clients.
# Canonical MCP resource URL (tokens are audience-bound to it).
MCP_PUBLIC_URL=http://localhost:4100/mcp
# Dynamic client registration lets anyone create an OAuth client: local dev only, leave unset in production.
OAUTH_OPEN_REGISTRATION=1
# Client ID Metadata Documents (how production MCP clients identify themselves). On by default.
# OAUTH_CIMD=0
# Production: BETTER_AUTH_URL must be the platform origin (https://app.ownlevel.app), not api.*, so the
# authorization server shares the browser session cookie. Optional: WEB_URL overrides the login/consent origin.
