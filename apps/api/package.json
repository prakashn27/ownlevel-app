    "db:migrate": "tsx --env-file-if-exists=.env src/migrate.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.17",
    "@ownlevel/core": "workspace:*",
    "@ownlevel/tenancy": "workspace:*",
    "better-auth": "^1.7.14",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.14",
    "pg": "^8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
