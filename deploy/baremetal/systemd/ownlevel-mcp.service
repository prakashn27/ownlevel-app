[Unit]
Description=Ownlevel MCP server (partner + client)
After=network-online.target ownlevel-migrate.service
Wants=network-online.target

[Service]
User=ownlevel
Group=ownlevel
WorkingDirectory=/opt/ownlevel/current/apps/mcp-server
EnvironmentFile=/etc/ownlevel/common.env
EnvironmentFile=/etc/ownlevel/mcp.env
Environment=NODE_ENV=production PORT=4100
ExecStart=/usr/bin/node dist/main.js
Restart=always
RestartSec=2
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
