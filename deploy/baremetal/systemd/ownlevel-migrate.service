[Unit]
Description=Ownlevel database migrations + RLS policies
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
User=ownlevel
Group=ownlevel
WorkingDirectory=/opt/ownlevel/current/packages/tenancy
EnvironmentFile=/etc/ownlevel/common.env
# migrations connect as the owner role, never the runtime role
EnvironmentFile=/etc/ownlevel/migrate.env
ExecStart=/usr/bin/node dist/migrate.js

[Install]
WantedBy=multi-user.target
